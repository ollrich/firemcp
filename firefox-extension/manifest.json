{
    "manifest_version": 2,
    "name": "__MSG_extensionName__",
    "version": "2.1.0",
    "description": "__MSG_extensionDescription__",
    "default_locale": "en",
    "author": "Oliver Eichhof",
    "homepage_url": "https://github.com/ollrich/firemcp",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "96": "icons/icon-96.png",
        "128": "icons/icon-128.png"
    },
    "permissions": [
        "tabs",
        "tabGroups",
        "storage",
        "activeTab"
    ],
    "optional_permissions": [
        "*://*/*",
        "find",
        "history",
        "bookmarks"
    ],
    "background": {
        "scripts": [
            "dist/background.js"
        ]
    },
    "browser_action": {
        "default_icon": "assets/screenshot.svg",
        "default_title": "__MSG_browserActionTitle__"
    },
    "options_ui": {
        "page": "options.html"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "firemcp@ollrich",
            "strict_min_version": "140.0",
            "update_url": "https://raw.githubusercontent.com/ollrich/firemcp/main/updates.json",
            "data_collection_permissions": {
                "required": [
                    "browsingActivity",
                    "websiteContent"
                ],
                "optional": [
                    "bookmarksInfo"
                ]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    }
}
