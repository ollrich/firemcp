{
    "manifest_version": 2,
    "name": "FireMCP",
    "version": "2.0.0",
    "description": "Lets a local MCP server read your Firefox tabs, pages and history for AI assistants, with consent per domain. Read only.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "96": "icons/icon-96.png",
        "128": "icons/icon-128.png"
    },
    "permissions": [
        "tabs",
        "tabGroups",
        "history",
        "storage",
        "activeTab"
    ],
    "optional_permissions": [
        "*://*/*",
        "find",
        "bookmarks"
    ],
    "background": {
        "scripts": [
            "dist/background.js"
        ]
    },
    "browser_action": {
        "default_icon": "assets/screenshot.svg",
        "default_title": "FireMCP: allow a screenshot of this tab"
    },
    "options_ui": {
        "page": "options.html"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "firemcp@ollrich",
            "strict_min_version": "140.0",
            "update_url": "https://raw.githubusercontent.com/ollrich/firemcp/main/updates.json",
            "data_collection_permissions": {
                "required": [
                    "browsingActivity",
                    "websiteContent",
                    "bookmarksInfo"
                ]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    }
}
